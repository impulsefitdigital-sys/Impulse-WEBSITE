# dépendances / build
node_modules
dist
dist-ssr
*.local

# secrets — ne jamais versionner
.env
.env.*
!.env.example

# sauvegardes contenant des données personnelles (clients, newsletter)
backup/
export-donnees/

# éditeurs / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.log
npm-debug.log*

# photos (originaux et versions optimisées) — jamais dans le dépôt
photos-source/
photos-optimisees/

# clés Firebase Admin
*-service-account*.json
serviceAccount*.json

# restauration Supabase (clé service_role, locale uniquement)
.env.restauration
